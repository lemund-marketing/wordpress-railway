#!/bin/bash
# Entrypoint do WordPress (imagem wordpress-railway). Prepara o contêiner e entrega para o Apache.
# Não mexe no conteúdo do site, só: portas, atalho do caminho antigo (CAMINHO_ANTIGO), autorrestauração
# (só com RESTAURAR_*; ver wpr-restaurar), auto_prepend (ex.: Wordfence), filtro da pré-visualização,
# mu-plugins da Railway e dono dos arquivos.
set -euo pipefail
DOCROOT=/var/www/html
export APACHE_MAX_WORKERS="${APACHE_MAX_WORKERS:-25}"
log() { echo "[entrypoint] $*"; }
cd /   # a restauração apaga pastas temporárias; sem isto o shell reclama de "getcwd" no log

# Um MPM só (mod_php exige o prefork). No runtime da Railway (relatos desde dez/2025, visto aqui em 03/11/2026) o
# mpm_event que a imagem base desliga volta a aparecer em mods-enabled: o "apache2ctl -t" do build passa e o
# Apache cai com AH00534 "More than one MPM loaded". Corrigido a cada boot, antes de qualquer outra coisa.
mods=/etc/apache2/mods-enabled
extras="$(cd "$mods" && ls mpm_event.* mpm_worker.* 2>/dev/null || true)"
if [ -n "$extras" ]; then
  (cd "$mods" && rm -f $extras)
  log "Apache: MPM a mais removido de mods-enabled ($(echo $extras)); fica só o prefork"
fi
[ -e "$mods/mpm_prefork.load" ] || { a2enmod -q mpm_prefork >/dev/null; log "Apache: mpm_prefork religado"; }

# Portas: o Apache escuta SEMPRE na 80 e, se houver PORT diferente, também nela. A Railway injeta PORT=8080 em
# todo serviço na hora de rodar (mesmo em imagem Docker); assim o domínio funciona com a porta de destino 80 ou
# 8080, sem depender de alguém lembrar de definir PORT.
PORT="${PORT:-80}"
case "$PORT" in
  ''|*[!0-9]*) log "AVISO: PORT='$PORT' não é um número; usando só a porta 80"; PORT=80 ;;
esac
PORTAS="80"; [ "$PORT" = 80 ] || PORTAS="80 $PORT"

# caminho absoluto do docroot no servidor antigo (ex.: /home/<usuário>/domains/<site>/public_html)
CAMINHO_ANTIGO="${CAMINHO_ANTIGO:-${HOSTINGER_DOCROOT:-}}"
case "$CAMINHO_ANTIGO" in
  "") ;;
  /var/www|/var/www/*|/|/usr|/usr/*|/etc|/etc/*|/bin|/bin/*|/sbin|/sbin/*|/proc|/proc/*|/dev|/dev/*)
    log "AVISO: CAMINHO_ANTIGO=$CAMINHO_ANTIGO não é permitido (área do sistema ou do próprio volume); ignorado"
    CAMINHO_ANTIGO="" ;;
  /*) ;;
  *) log "AVISO: CAMINHO_ANTIGO precisa ser um caminho absoluto; ignorado"; CAMINHO_ANTIGO="" ;;
esac
export CAMINHO_ANTIGO

# (reescritos a cada boot: um reinício com outra PORT não acumula portas antigas)
vhosts=""
: > /etc/apache2/ports.conf
for p in $PORTAS; do echo "Listen $p" >> /etc/apache2/ports.conf; vhosts="$vhosts *:$p"; done
sed -ri "s/^<VirtualHost [^>]*>/<VirtualHost${vhosts}>/" /etc/apache2/sites-available/000-default.conf

# Volume: sem volume em /var/www, tudo o que o site gravar some no próximo deploy (só avisa; quem trava é o
# wpr-restaurar, quando há RESTAURAR_*)
vrc=0; wpr-volume || vrc=$?
case "$vrc" in
  1) log "AVISO: /var/www não é um volume: arquivos gravados pelo site somem no próximo deploy (monte um volume em /var/www)" ;;
  2) log "AVISO: o volume está montado em /var/www/html; o certo é montar em /var/www" ;;
esac

mkdir -p "$DOCROOT"
chown www-data:www-data "$DOCROOT" /var/www

# Atalho de compatibilidade: CAMINHO_ANTIGO -> /var/www/html
# (logs, caches e configs regeneráveis que guardaram o caminho antigo continuam resolvendo)
if [ -n "$CAMINHO_ANTIGO" ]; then
  if [ -d "$CAMINHO_ANTIGO" ] && [ ! -L "$CAMINHO_ANTIGO" ]; then
    log "AVISO: $CAMINHO_ANTIGO já existe como pasta de verdade; atalho não criado"
  else
    mkdir -p "$(dirname "$CAMINHO_ANTIGO")"
    ln -sfn "$DOCROOT" "$CAMINHO_ANTIGO"
  fi
fi

# Autorrestauração (RESTAURAR_*): roda ANTES do Apache; sem as variáveis não faz nada.
if ! wpr-restaurar; then
  log "ERRO: a restauração automática falhou (detalhes acima). O site NÃO foi iniciado e nada foi marcado como restaurado."
  log "Corrija as variáveis RESTAURAR_* (ou remova-as) e reimplante."
  exit 1
fi
# A restauração terminou: as RESTAURAR_* (URL e usuário:senha da pasta de download) saem do ambiente antes do
# Apache, para o PHP (plugins, getenv, $_SERVER) não ter como lê-las.
restaurar_vars="$(compgen -e | grep '^RESTAURAR_' || true)"
if [ -n "$restaurar_vars" ]; then
  for v in $restaurar_vars; do unset "$v"; done
  log "variáveis RESTAURAR_* retiradas do ambiente do Apache/PHP"
fi

# auto_prepend_file (ex.: Wordfence "proteção estendida"): na hospedagem vinha do .htaccess (bloco LiteSpeed);
# no Apache vem do php.ini
ini="$PHP_INI_DIR/conf.d/zz-auto-prepend.ini"
rm -f "$ini"
if [ -n "${PHP_AUTO_PREPEND_FILE:-}" ]; then
  if [ -f "$PHP_AUTO_PREPEND_FILE" ]; then
    printf 'auto_prepend_file = "%s"\n' "$PHP_AUTO_PREPEND_FILE" > "$ini"
    log "auto_prepend_file = $PHP_AUTO_PREPEND_FILE"
  else
    log "AVISO: PHP_AUTO_PREPEND_FILE=$PHP_AUTO_PREPEND_FILE não existe (ainda); ignorado"
  fi
fi

wpr-preview-apache
wpr-bloqueios-apache
wpr-mu-plugins

# dono: só corre a árvore inteira se achar algo fora do www-data
if [ -n "$(find "$DOCROOT" -xdev \( ! -user www-data -o ! -group www-data \) -print -quit 2>/dev/null)" ]; then
  log "corrigindo dono dos arquivos para www-data"
  find "$DOCROOT" -xdev \( ! -user www-data -o ! -group www-data \) -exec chown -h www-data:www-data {} +
fi

log "docroot: $(find "$DOCROOT" -mindepth 1 -maxdepth 1 | wc -l) itens no 1º nível; PHP $(php -r 'echo PHP_VERSION;'); portas ${PORTAS// / e }"
exec "$@"
